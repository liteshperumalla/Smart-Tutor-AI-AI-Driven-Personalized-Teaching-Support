# TEMPLATE: Replace values with actual secrets before applying
# Use Kubernetes secrets or external secret management (AWS Secrets Manager, Vault)
apiVersion: v1
kind: Secret
metadata:
  name: backend-secrets
  labels:
    app: smart-ai-tutor
    component: backend
type: Opaque
stringData:
  # Database Credentials
  POSTGRES_USER: "REPLACE_WITH_DB_USER"
  POSTGRES_PASSWORD: "REPLACE_WITH_DB_PASSWORD"

  # Redis Password
  REDIS_PASSWORD: "REPLACE_WITH_REDIS_PASSWORD"

  # JWT Secret
  JWT_SECRET_KEY: "REPLACE_WITH_JWT_SECRET"

  # Google OAuth Credentials
  GOOGLE_CLIENT_ID: "REPLACE_WITH_GOOGLE_CLIENT_ID"
  GOOGLE_CLIENT_SECRET: "REPLACE_WITH_GOOGLE_CLIENT_SECRET"
  GOOGLE_REDIRECT_URI: "https://smart-ai-tutor.com/api/v1/auth/google/callback"

  # AWS Credentials (if not using IAM roles)
  AWS_ACCESS_KEY_ID: "REPLACE_WITH_AWS_ACCESS_KEY"
  AWS_SECRET_ACCESS_KEY: "REPLACE_WITH_AWS_SECRET_KEY"

  # AWS Bedrock Configuration
  BEDROCK_REGION: "us-east-1"
  BEDROCK_MODEL_ID: "anthropic.claude-3-sonnet-20240229-v1:0"

  # DynamoDB Configuration
  DYNAMODB_TABLE_PREFIX: "smart-tutor"

  # Encryption Keys
  ENCRYPTION_KEY: "REPLACE_WITH_32_BYTE_ENCRYPTION_KEY"

---
