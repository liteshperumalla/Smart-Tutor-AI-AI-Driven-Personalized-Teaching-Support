# Production-Ready Configuration (Hybrid: Postgres + DynamoDB + Bedrock)

# Environment
ENVIRONMENT=production
DEBUG=false
ENFORCE_HTTPS=true

# ── Cloud Provider Settings (Multi-Cloud Abstraction) ──────────────
# CLOUD_PROVIDER: "aws" (default) or "local" (no cloud dependencies)
CLOUD_PROVIDER=aws

# SECRETS_PROVIDER: "aws" (Secrets Manager) or "env" (environment vars only)
#   Auto-detected: "aws" in production/staging, "env" in development
# SECRETS_PROVIDER=aws

# OBJECT_STORAGE_PROVIDER: "s3" (default) or "local" (filesystem)
OBJECT_STORAGE_PROVIDER=s3

# EVENT_BUS_BACKEND: "inmemory" (default), "eventbridge", or "sns"
# EVENT_BUS_BACKEND=inmemory
# ────────────────────────────────────────────────────────────────────

# Security Settings
# SECURITY: Code execution endpoint (DISABLE in production)
ENABLE_CODE_EXECUTION=false

# SECURITY: Grafana admin password (change this!)
GRAFANA_ADMIN_PASSWORD=<change-this-strong-password>

# SECURITY: PostgreSQL password (use Secrets Manager in production)
POSTGRES_PASSWORD=<use-secrets-manager-in-production>

# SECURITY: Loopback-only host ports (override for local access as needed)
POSTGRES_PORT_EXPOSE=5432
BACKEND_PORT_EXPOSE=8010
FRONTEND_PORT_EXPOSE=4000
GRAFANA_PORT_EXPOSE=3001

# JWT / Auth
# SECURITY: JWT_SECRET_KEY must be stored in AWS Secrets Manager (smart-tutor/app/secrets)
# The application loads it automatically from Secrets Manager - do NOT set it here
JWT_ALGORITHM=RS256
# Key paths are relative to project root for local/Docker, or absolute paths for Lambda
# For Docker: mount keys directory as volume with these relative paths
# For Lambda: use environment-mounted secrets or Parameter Store
JWT_PRIVATE_KEY_PATH=keys/jwt_private.pem
JWT_PUBLIC_KEY_PATH=keys/jwt_public.pem
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Storage backend
STORAGE_BACKEND=hybrid

# PostgreSQL (RDS)
POSTGRES_HOST=<rds-endpoint>
POSTGRES_PORT=5432
POSTGRES_DB=smart_tutor
POSTGRES_USER=<db-user>
POSTGRES_PASSWORD=<db-password>
POSTGRES_MIN_CONNECTIONS=2
POSTGRES_MAX_CONNECTIONS=10

# DynamoDB (AWS)
# Leave DYNAMODB_ENDPOINT empty for AWS; set only for local emulator.
DYNAMODB_ENDPOINT=
DYNAMODB_REGION=us-east-1
DYNAMODB_TABLE_CHAT_SESSIONS=smart-tutor-chat-sessions
DYNAMODB_TABLE_USERS=smart-tutor-users
DYNAMODB_TABLE_QUIZ_RESULTS=smart-tutor-quiz-results

# Redis Cache (optional)
USE_REDIS_CACHE=false
REDIS_HOST=<redis-host>
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=<required-redis-password>
REDIS_SSL=true
REDIS_MAX_CONNECTIONS=50

# Observability
LANGFUSE_PUBLIC_KEY=<langfuse-public>
LANGFUSE_SECRET_KEY=<langfuse-secret>
LANGFUSE_HOST=https://us.cloud.langfuse.com
LANGFUSE_ENABLED=true
ALERTS_EMAIL_TO=<alerts-email-recipient>
SLACK_WEBHOOK_URL=<optional-slack-webhook>
SERPAPI_API_KEY=<serpapi-key>
OPENAI_API_KEY=<openai-key>
GOOGLE_OAUTH_CLIENT_ID=<google-client-id>
GOOGLE_OAUTH_CLIENT_SECRET=<google-client-secret>
GOOGLE_OAUTH_REDIRECT_URI=https://your-frontend/auth/google/callback

# LLM Routing (Complexity-Based Model Selection)
# Routes simple queries to a cheaper model, complex queries to the full model
LLM_ROUTING_ENABLED=false
LLM_ROUTING_SIMPLE_MODEL=us.anthropic.claude-3-haiku-20240307-v1:0
LLM_ROUTING_COMPLEX_MODEL=us.anthropic.claude-3-5-sonnet-20241022-v2:0
LLM_ROUTING_COMPLEXITY_THRESHOLD=0.5  # Score threshold: lower = more queries classified as complex

# Cache settings
CACHE_ENABLED=true
CACHE_TTL=300
CACHE_MAX_SIZE=1000

# Answer Cache (Query->Answer caching to avoid repeated RAG+LLM calls)
ANSWER_CACHE_ENABLED=false
ANSWER_CACHE_TTL=3600  # 1 hour
ANSWER_CACHE_FUZZY_THRESHOLD=0.95  # Cosine similarity threshold for fuzzy matching

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60
RATE_LIMIT_PER_USER_REQUESTS=60
RATE_LIMIT_PER_USER_WINDOW=60

# Per-model rate limiting (per user, per model family, hourly window)
MODEL_RATE_LIMIT_DEFAULT=30   # Llama / uncategorized models
MODEL_RATE_LIMIT_FAST=30      # Haiku (cheap/fast)
MODEL_RATE_LIMIT_PRO=15       # Sonnet (capable)
MODEL_RATE_LIMIT_ADMIN=5      # Opus (most expensive)
MODEL_RATE_LIMIT_WINDOW=3600  # 1 hour reset window
LLM_MAX_CONCURRENT=10         # Max concurrent LLM synthesis calls (backpressure)

# Email (SMTP)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=<smtp-username>
SMTP_PASSWORD=<smtp-password>
EMAIL_FROM=<from-email>
EMAIL_VERIFICATION_CODE_TTL_SECONDS=900
PASSWORD_SETUP_TOKEN_TTL_SECONDS=900
PASSWORD_RESET_TOKEN_TTL_SECONDS=3600



# CORS Configuration
# Comma-separated list of allowed origins for production
# Example: CORS_ALLOWED_ORIGINS=https://smartaitutor.com,https://app.smartaitutor.com
CORS_ALLOWED_ORIGINS=
# Allow localhost for local development (set to false in production)
CORS_ALLOW_LOCALHOST=false

# Phase 4: AWS Bedrock
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=<aws-account-id>

# SECURITY: Do NOT use AWS credentials in environment variables
# Use IAM roles (EC2/ECS/Lambda) or AWS Secrets Manager for production
# For local development, use AWS CLI credential profiles (~/.aws/credentials)
# AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY should NEVER be committed

# LLM Provider (bedrock or ollama)
LLM_PROVIDER=bedrock
EMBEDDING_PROVIDER=bedrock

BEDROCK_MODEL_ID=meta.llama3-70b-instruct-v1:0
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0

# S3 Buckets
S3_DOCUMENTS_BUCKET=smart-ai-tutor-docs
S3_UPLOADS_BUCKET=smart-ai-tutor-uploads
USE_S3_VECTORS=true

# Bedrock Knowledge Base (optional)
BEDROCK_KB_ID=
BEDROCK_KB_ENABLED=false

# Cost Tracking
ENABLE_COST_TRACKING=true
COST_LOG_FILE=logs/bedrock_costs.jsonl

# Logging / CloudWatch
CLOUDWATCH_LOG_GROUP=/aws/smart-ai-tutor/backend
CLOUDWATCH_ENABLED=true

# Enhanced RAG Pipeline
# Master toggle: when false, query enhancement / reranking / self-RAG are all bypassed
ENHANCED_RAG_ENABLED=false
# Cross-encoder reranking (over-fetch 10, rerank to top 3)
RERANKING_ENABLED=false

# Agent System (Multi-Agent LangGraph)
AGENT_SYSTEM_ENABLED=false
AGENT_LLM_ROUTING_ENABLED=false
AGENT_DEFAULT_LEVEL=intermediate
AGENT_GRAPH_RECURSION_LIMIT=10

# Neo4j Knowledge Graph
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
# SECURITY: Change this! Generate a strong password (min 32 chars)
NEO4J_PASSWORD=<generate-strong-password-here>
NEO4J_DATABASE=neo4j
