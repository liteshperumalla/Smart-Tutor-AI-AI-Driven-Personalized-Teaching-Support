# Production-Ready Configuration (Hybrid: Postgres + DynamoDB + Bedrock)

# Environment
ENVIRONMENT=production
DEBUG=false
ENFORCE_HTTPS=true

# Security Settings
# SECURITY: Code execution endpoint (DISABLE in production)
ENABLE_CODE_EXECUTION=false

# SECURITY: Grafana admin password (change this!)
GRAFANA_ADMIN_PASSWORD=<change-this-strong-password>

# SECURITY: PostgreSQL password (use Secrets Manager in production)
POSTGRES_PASSWORD=<use-secrets-manager-in-production>

# SECURITY: Port exposure (leave empty in production to not expose ports)
POSTGRES_PORT_EXPOSE=  # Empty = don't expose port

# JWT / Auth
# SECURITY: JWT_SECRET_KEY must be stored in AWS Secrets Manager (smart-tutor/app/secrets)
# The application loads it automatically from Secrets Manager - do NOT set it here
JWT_ALGORITHM=RS256
# Key paths are relative to project root for local/Docker, or absolute paths for Lambda
# For Docker: mount keys directory as volume with these relative paths
# For Lambda: use environment-mounted secrets or Parameter Store
JWT_PRIVATE_KEY_PATH=keys/jwt_private.pem
JWT_PUBLIC_KEY_PATH=keys/jwt_public.pem
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Storage backend
STORAGE_BACKEND=hybrid

# PostgreSQL (RDS)
POSTGRES_HOST=<rds-endpoint>
POSTGRES_PORT=5432
POSTGRES_DB=smart_tutor
POSTGRES_USER=<db-user>
POSTGRES_PASSWORD=<db-password>
POSTGRES_MIN_CONNECTIONS=2
POSTGRES_MAX_CONNECTIONS=10

# DynamoDB (AWS)
# Leave DYNAMODB_ENDPOINT empty for AWS; set only for local emulator.
DYNAMODB_ENDPOINT=
DYNAMODB_REGION=us-east-1
DYNAMODB_TABLE_CHAT_SESSIONS=smart-tutor-chat-sessions
DYNAMODB_TABLE_USERS=smart-tutor-users
DYNAMODB_TABLE_QUIZ_RESULTS=smart-tutor-quiz-results

# Redis Cache (optional)
USE_REDIS_CACHE=false
REDIS_HOST=<redis-host>
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_SSL=true
REDIS_MAX_CONNECTIONS=50

# Observability
LANGFUSE_PUBLIC_KEY=<langfuse-public>
LANGFUSE_SECRET_KEY=<langfuse-secret>
LANGFUSE_HOST=https://us.cloud.langfuse.com
LANGFUSE_ENABLED=true
SERPAPI_API_KEY=<serpapi-key>
OPENAI_API_KEY=<openai-key>
GOOGLE_OAUTH_CLIENT_ID=<google-client-id>
GOOGLE_OAUTH_CLIENT_SECRET=<google-client-secret>
GOOGLE_OAUTH_REDIRECT_URI=https://your-frontend/auth/google/callback

# Cache settings
CACHE_ENABLED=true
CACHE_TTL=300
CACHE_MAX_SIZE=1000

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60
RATE_LIMIT_PER_USER_REQUESTS=60
RATE_LIMIT_PER_USER_WINDOW=60

# Email (SMTP)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=<smtp-username>
SMTP_PASSWORD=<smtp-password>
EMAIL_FROM=<from-email>
PASSWORD_RESET_TOKEN_TTL_SECONDS=3600



# CORS Configuration
# Comma-separated list of allowed origins for production
# Example: CORS_ALLOWED_ORIGINS=https://smartaitutor.com,https://app.smartaitutor.com
CORS_ALLOWED_ORIGINS=
# Allow localhost for local development (set to false in production)
CORS_ALLOW_LOCALHOST=false

# Phase 4: AWS Bedrock
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=<aws-account-id>

# SECURITY: Do NOT use AWS credentials in environment variables
# Use IAM roles (EC2/ECS/Lambda) or AWS Secrets Manager for production
# For local development, use AWS CLI credential profiles (~/.aws/credentials)
# AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY should NEVER be committed

# LLM Provider (bedrock or ollama)
LLM_PROVIDER=bedrock
EMBEDDING_PROVIDER=bedrock

BEDROCK_MODEL_ID=meta.llama3-70b-instruct-v1:0
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0

# S3 Buckets
S3_DOCUMENTS_BUCKET=smart-ai-tutor-docs
S3_UPLOADS_BUCKET=smart-ai-tutor-uploads
USE_S3_VECTORS=true

# Bedrock Knowledge Base (optional)
BEDROCK_KB_ID=
BEDROCK_KB_ENABLED=false

# Cost Tracking
ENABLE_COST_TRACKING=true
COST_LOG_FILE=logs/bedrock_costs.jsonl

# Logging / CloudWatch
CLOUDWATCH_LOG_GROUP=/aws/smart-ai-tutor/backend
CLOUDWATCH_ENABLED=true
