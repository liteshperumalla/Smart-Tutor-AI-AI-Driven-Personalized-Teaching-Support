# Smart AI Tutor - Environment Configuration
# Copy this file to .env and update with your values

# ==========================================
# Application Settings
# ==========================================
APP_NAME="Smart AI Tutor"
APP_VERSION="1.0.0"
DEBUG=false
ENVIRONMENT=production  # development, staging, production

# ==========================================
# Security Settings
# ==========================================
SECRET_KEY=change-this-to-a-random-secret-key-in-production
SESSION_TIMEOUT=3600  # Session timeout in seconds (1 hour)
MAX_LOGIN_ATTEMPTS=5  # Maximum failed login attempts before lockout
LOCKOUT_DURATION=900  # Account lockout duration in seconds (15 minutes)

# Password Requirements
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_DIGIT=true
PASSWORD_REQUIRE_SPECIAL=true

# ==========================================
# Database Settings
# ==========================================
USER_DATA_ROOT=user_data
USERS_FILE=users.json
PREV_CHAT_DIR=previous_chats
QUIZ_RESULTS_DIR=quiz_results

# ==========================================
# RAG & AI Settings
# ==========================================
PERSIST_DIR=./persisted_index
CHROMA_DB_PATH=./chroma_db
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
LLM_MODEL=llama3.2:latest
LLM_REQUEST_TIMEOUT=120.0
OLLAMA_BASE_URL=http://localhost:11434

# Retrieval Settings
SIMILARITY_TOP_K=3
CONFIDENCE_THRESHOLD=0.3
CHUNK_SIZE=100
CHUNK_OVERLAP=10

# ==========================================
# Web Search Settings
# ==========================================
WEB_SEARCH_ENABLED=true
SERPAPI_API_KEY=your-serpapi-key-here
MAX_WEB_RESULTS=3

# ==========================================
# Langfuse Monitoring (Optional)
# ==========================================
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=your-public-key-here
LANGFUSE_SECRET_KEY=your-secret-key-here
LANGFUSE_HOST=https://cloud.langfuse.com

# ==========================================
# Google OAuth Settings
# ==========================================
GOOGLE_OAUTH_CLIENT_ID=your-google-client-id
GOOGLE_OAUTH_CLIENT_SECRET=your-google-client-secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8501

# ==========================================
# Email Settings (for notifications)
# ==========================================
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=your-email@gmail.com

# ==========================================
# Cache Settings
# ==========================================
CACHE_ENABLED=true
CACHE_TTL=300  # Cache time-to-live in seconds (5 minutes)
CACHE_MAX_SIZE=1000  # Maximum number of cached items

# ==========================================
# Rate Limiting
# ==========================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100  # Maximum requests per period
RATE_LIMIT_PERIOD=60  # Period in seconds

# ==========================================
# File Upload Settings
# ==========================================
MAX_UPLOAD_SIZE=10485760  # Maximum file size in bytes (10MB)
ALLOWED_EXTENSIONS=.pdf,.docx,.pptx,.txt,.png,.jpg,.jpeg

# ==========================================
# Logging Settings
# ==========================================
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FILE=logs/app.log
LOG_FORMAT=json  # json or text
LOG_MAX_BYTES=10485760  # Maximum log file size (10MB)
LOG_BACKUP_COUNT=5  # Number of backup log files to keep
