# Production-Ready Configuration
# SECURITY: ALL SECRETS MUST BE SET VIA AWS SECRETS MANAGER OR ENVIRONMENT VARIABLES
# DO NOT COMMIT ACTUAL SECRET VALUES TO VERSION CONTROL

# Environment
ENVIRONMENT=development
DEBUG=false

# ===================================================================
# CRITICAL SECURITY NOTICE
# ===================================================================
# All sensitive values below are loaded from AWS Secrets Manager in production
# Local development: Use .env.local (add to .gitignore)
# Production: Values are fetched from secret: smart-tutor/app/secrets

# Phase 1: JWT Security
# SECURITY: These values MUST be loaded from AWS Secrets Manager
# Run: aws secretsmanager get-secret-value --secret-id smart-tutor/app/secrets
JWT_SECRET_KEY=  # Loaded from Secrets Manager - REQUIRED in production
JWT_ALGORITHM=RS256
JWT_PRIVATE_KEY_PATH=keys/jwt_private.pem
JWT_PUBLIC_KEY_PATH=keys/jwt_public.pem
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Phase 2: Database Configuration (AWS RDS PostgreSQL)
# SECURITY: Use IAM authentication or load password from Secrets Manager
STORAGE_BACKEND=hybrid
POSTGRES_HOST=smart-tutor-postgres.cmfouoe8c2p1.us-east-1.rds.amazonaws.com
POSTGRES_PORT=5432
POSTGRES_DB=smart_tutor
POSTGRES_USER=smart_tutor_admin
POSTGRES_PASSWORD=  # Loaded from Secrets Manager - NEVER commit actual password
POSTGRES_MIN_CONNECTIONS=2
POSTGRES_MAX_CONNECTIONS=10

# DynamoDB Configuration
# DYNAMODB_ENDPOINT=http://localhost:8001  # Only for local development
DYNAMODB_REGION=us-east-1
DYNAMODB_TABLE_CHAT_SESSIONS=smart-tutor-chat-sessions

# Phase 3: Redis Caching
USE_REDIS_CACHE=true
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=  # Set if Redis requires authentication
REDIS_SSL=false
REDIS_MAX_CONNECTIONS=50

# External Services (Loaded from Secrets Manager)
# SECURITY: All API keys MUST be in Secrets Manager
LANGFUSE_PUBLIC_KEY=  # Loaded from Secrets Manager
LANGFUSE_SECRET_KEY=  # Loaded from Secrets Manager
LANGFUSE_HOST=https://us.cloud.langfuse.com
LANGFUSE_ENABLED=true

SERPAPI_API_KEY=  # Loaded from Secrets Manager
OPENAI_API_KEY=  # Loaded from Secrets Manager (if used)

# Google OAuth Configuration
GOOGLE_OAUTH_CLIENT_ID=96179087878-5gke05am5bm3c65nvo3mbqlau6ula654.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=  # Loaded from Secrets Manager - NEVER commit
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:4000/auth/google/callback

# Cache settings
CACHE_ENABLED=true
CACHE_TTL=300
CACHE_MAX_SIZE=1000

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60

# Per-user rate limiting (Redis-based)
RATE_LIMIT_PER_USER_REQUESTS=60
RATE_LIMIT_PER_USER_WINDOW=60

# Email Configuration (SMTP)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=  # Set via environment variable or Secrets Manager
SMTP_PASSWORD=  # Loaded from Secrets Manager - NEVER commit
EMAIL_FROM=noreply@smartaitutor.com  # Update with your domain
PASSWORD_RESET_TOKEN_TTL_SECONDS=3600

# HTTPS enforcement
ENFORCE_HTTPS=false  # Set to true in production

# CORS Configuration
# SECURITY: MUST set actual production domains before deployment
# Example: CORS_ALLOWED_ORIGINS=https://smartaitutor.com,https://app.smartaitutor.com
CORS_ALLOWED_ORIGINS=  # REQUIRED in production - comma-separated list
CORS_ALLOW_LOCALHOST=false  # Set to false in production

# ===================================================================
# Phase 4: AWS Configuration
# ===================================================================
# SECURITY: Use IAM roles instead of access keys in production
# EC2/ECS instances should use IAM instance profiles
# DO NOT SET AWS_ACCESS_KEY_ID or AWS_SECRET_ACCESS_KEY in production

AWS_REGION=us-east-1
# AWS_ACCOUNT_ID is not a secret but can be omitted (derived from STS)
AWS_ACCOUNT_ID=  # Optional - can be derived from boto3 STS

# For local development only - production uses IAM roles
# AWS_ACCESS_KEY_ID=  # Use AWS CLI profile instead
# AWS_SECRET_ACCESS_KEY=  # Use AWS CLI profile instead

# LLM Provider Configuration
LLM_PROVIDER=bedrock
EMBEDDING_PROVIDER=bedrock

# AWS Bedrock Models
BEDROCK_MODEL_ID=meta.llama3-70b-instruct-v1:0
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
BEDROCK_REGION=us-east-1

# S3 Configuration for Vector Storage
S3_BUCKET_NAME=smart-tutor-vectors
S3_BUCKET_REGION=us-east-1

# Cost Tracking
ENABLE_COST_TRACKING=true
COST_LOG_PATH=logs/bedrock_costs.jsonl

# File Upload Settings
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=10485760  # 10MB in bytes
ALLOWED_EXTENSIONS=.pdf,.docx,.pptx,.txt,.png,.jpg,.jpeg

# Logging Configuration
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FORMAT=json  # json or text
LOG_FILE=logs/backend.log

# ===================================================================
# SETUP INSTRUCTIONS FOR PRODUCTION
# ===================================================================
#
# 1. ROTATE ALL CREDENTIALS (if previously exposed):
#    aws iam create-access-key --user-name smart-tutor
#    aws iam delete-access-key --access-key-id OLD_KEY
#
# 2. CREATE AWS SECRETS MANAGER SECRET:
#    aws secretsmanager create-secret \
#      --name smart-tutor/app/secrets \
#      --secret-string '{
#        "jwt_secret_key": "GENERATE-NEW-KEY",
#        "postgres_password": "GENERATE-NEW-PASSWORD",
#        "serpapi_api_key": "YOUR-KEY",
#        "langfuse_public_key": "YOUR-KEY",
#        "langfuse_secret_key": "YOUR-KEY",
#        "google_oauth_client_secret": "YOUR-SECRET",
#        "smtp_password": "YOUR-PASSWORD",
#        "smtp_username": "YOUR-EMAIL"
#      }'
#
# 3. USE IAM ROLES FOR AWS ACCESS:
#    - Attach appropriate IAM roles to EC2/ECS instances
#    - Remove AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY
#
# 4. UPDATE CORS_ALLOWED_ORIGINS:
#    - Set actual production domain(s)
#    - Example: CORS_ALLOWED_ORIGINS=https://yourdomain.com
#
# 5. ENABLE HTTPS:
#    - Set ENFORCE_HTTPS=true
#    - Update GOOGLE_OAUTH_REDIRECT_URI to https://
#
# 6. VERIFY SECRETS MANAGER ACCESS:
#    python -c "from backend.config import config; print(config.JWT_SECRET_KEY)"
#
# ===================================================================
