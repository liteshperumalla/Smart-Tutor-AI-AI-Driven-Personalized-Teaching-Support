{
  "description": "Gold-standard evaluation dataset for RAG pipeline testing",
  "version": "1.0",
  "created": "2025-11-05",
  "purpose": "Benchmark RAG improvements with known question-answer pairs",
  "usage": "Use this dataset to measure retrieval accuracy and response quality",

  "test_cases": [
    {
      "id": "test_001",
      "category": "factual",
      "query": "What is Python?",
      "expected_topics": ["programming language", "high-level", "interpreted", "dynamic typing"],
      "difficulty": "easy",
      "expected_retrieval_count": 3,
      "notes": "Basic definitional question"
    },
    {
      "id": "test_002",
      "category": "conceptual",
      "query": "Explain the difference between lists and tuples in Python",
      "expected_topics": ["mutable vs immutable", "list is mutable", "tuple is immutable", "performance"],
      "difficulty": "medium",
      "expected_retrieval_count": 3,
      "notes": "Comparison question requiring understanding of two concepts"
    },
    {
      "id": "test_003",
      "category": "procedural",
      "query": "How do you create a virtual environment in Python?",
      "expected_topics": ["venv", "virtualenv", "python -m venv", "activation"],
      "difficulty": "medium",
      "expected_retrieval_count": 3,
      "notes": "Step-by-step procedural question"
    },
    {
      "id": "test_004",
      "category": "debugging",
      "query": "What causes a KeyError in Python dictionaries?",
      "expected_topics": ["key not found", "dictionary", "exception", "key existence"],
      "difficulty": "medium",
      "expected_retrieval_count": 2,
      "notes": "Error understanding question"
    },
    {
      "id": "test_005",
      "category": "advanced",
      "query": "Explain Python decorators and how they work",
      "expected_topics": ["decorator", "function wrapper", "@syntax", "higher-order function"],
      "difficulty": "hard",
      "expected_retrieval_count": 4,
      "notes": "Advanced concept requiring deep understanding"
    },
    {
      "id": "test_006",
      "category": "comparison",
      "query": "What's the difference between == and is in Python?",
      "expected_topics": ["equality", "identity", "value comparison", "object reference"],
      "difficulty": "medium",
      "expected_retrieval_count": 2,
      "notes": "Subtle distinction that often confuses beginners"
    },
    {
      "id": "test_007",
      "category": "best_practices",
      "query": "What are Python list comprehensions and when should you use them?",
      "expected_topics": ["list comprehension", "syntax", "readability", "performance", "use cases"],
      "difficulty": "medium",
      "expected_retrieval_count": 3,
      "notes": "Best practices question"
    },
    {
      "id": "test_008",
      "category": "data_structures",
      "query": "Explain how Python dictionaries work internally",
      "expected_topics": ["hash table", "key-value pairs", "hashing", "O(1) lookup"],
      "difficulty": "hard",
      "expected_retrieval_count": 4,
      "notes": "Internal implementation question"
    },
    {
      "id": "test_009",
      "category": "syntax",
      "query": "What is the difference between *args and **kwargs?",
      "expected_topics": ["variable arguments", "args for positional", "kwargs for keyword", "unpacking"],
      "difficulty": "medium",
      "expected_retrieval_count": 2,
      "notes": "Common syntax question"
    },
    {
      "id": "test_010",
      "category": "object_oriented",
      "query": "What is the purpose of __init__ in Python classes?",
      "expected_topics": ["constructor", "initialization", "self", "instance variables"],
      "difficulty": "easy",
      "expected_retrieval_count": 2,
      "notes": "OOP basics"
    },
    {
      "id": "test_011",
      "category": "ambiguous",
      "query": "Python loops",
      "expected_topics": ["for loop", "while loop", "iteration", "break", "continue"],
      "difficulty": "easy",
      "expected_retrieval_count": 3,
      "notes": "Intentionally vague - tests query rewriting"
    },
    {
      "id": "test_012",
      "category": "multi_hop",
      "query": "How does garbage collection work in Python and how does it relate to reference counting?",
      "expected_topics": ["garbage collection", "reference counting", "circular references", "gc module"],
      "difficulty": "hard",
      "expected_retrieval_count": 5,
      "notes": "Multi-hop reasoning required"
    },
    {
      "id": "test_013",
      "category": "performance",
      "query": "Which is faster: list.append() or list concatenation with +?",
      "expected_topics": ["append", "concatenation", "performance", "time complexity", "memory"],
      "difficulty": "medium",
      "expected_retrieval_count": 3,
      "notes": "Performance comparison question"
    },
    {
      "id": "test_014",
      "category": "edge_cases",
      "query": "What happens when you divide by zero in Python?",
      "expected_topics": ["ZeroDivisionError", "exception", "error handling", "try-except"],
      "difficulty": "easy",
      "expected_retrieval_count": 2,
      "notes": "Edge case handling"
    },
    {
      "id": "test_015",
      "category": "acronym",
      "query": "What is OOP in Python?",
      "expected_topics": ["Object-Oriented Programming", "classes", "objects", "inheritance", "encapsulation"],
      "difficulty": "easy",
      "expected_retrieval_count": 3,
      "notes": "Acronym expansion - tests query rewriting"
    },
    {
      "id": "test_016",
      "category": "contextual",
      "query": "When should I use a set instead of a list?",
      "expected_topics": ["set", "list", "uniqueness", "performance", "use cases", "unordered"],
      "difficulty": "medium",
      "expected_retrieval_count": 3,
      "notes": "Context-dependent recommendation"
    },
    {
      "id": "test_017",
      "category": "troubleshooting",
      "query": "Why am I getting an IndentationError?",
      "expected_topics": ["indentation", "whitespace", "syntax error", "Python syntax rules"],
      "difficulty": "easy",
      "expected_retrieval_count": 2,
      "notes": "Common beginner issue"
    },
    {
      "id": "test_018",
      "category": "advanced",
      "query": "Explain Python metaclasses",
      "expected_topics": ["metaclass", "type", "class creation", "advanced OOP"],
      "difficulty": "very_hard",
      "expected_retrieval_count": 4,
      "notes": "Very advanced topic"
    },
    {
      "id": "test_019",
      "category": "libraries",
      "query": "What is NumPy used for?",
      "expected_topics": ["NumPy", "numerical computing", "arrays", "scientific computing", "Python library"],
      "difficulty": "easy",
      "expected_retrieval_count": 2,
      "notes": "Library-specific question"
    },
    {
      "id": "test_020",
      "category": "version_differences",
      "query": "What are the main differences between Python 2 and Python 3?",
      "expected_topics": ["print function", "unicode", "division", "syntax changes", "Python versions"],
      "difficulty": "medium",
      "expected_retrieval_count": 4,
      "notes": "Version comparison question"
    }
  ],

  "evaluation_metrics": {
    "retrieval_metrics": [
      "precision@k (k=3, 5)",
      "recall@k (k=3, 5)",
      "MRR (Mean Reciprocal Rank)",
      "NDCG (Normalized Discounted Cumulative Gain)"
    ],
    "generation_metrics": [
      "relevance_score (1-5 scale)",
      "completeness (covered expected topics)",
      "accuracy (factually correct)",
      "clarity (easy to understand)"
    ],
    "end_to_end_metrics": [
      "response_time",
      "user_satisfaction (thumbs up/down)",
      "hallucination_rate"
    ]
  },

  "instructions": {
    "how_to_use": [
      "1. Run each test query through your RAG pipeline",
      "2. Check if retrieved documents contain expected topics",
      "3. Verify retrieval count matches expected_retrieval_count (+/- 1)",
      "4. Evaluate response quality against expected_topics",
      "5. Log results using the evaluation framework",
      "6. Calculate aggregate metrics across all test cases"
    ],
    "baseline_testing": [
      "Test with Phase 1 settings first to establish baseline",
      "Then test with Phase 2 settings to measure improvements",
      "Compare metrics: retrieval accuracy, response quality, latency"
    ],
    "success_criteria": {
      "retrieval": "85%+ of queries should retrieve relevant documents",
      "coverage": "80%+ of expected topics should be covered in responses",
      "latency": "95% of queries should complete in <5 seconds",
      "quality": "90%+ user satisfaction rating"
    }
  }
}
