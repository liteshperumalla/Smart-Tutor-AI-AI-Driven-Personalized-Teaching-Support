{
  "id": "langfuse-cost-dashboard",
  "name": "Smart AI Tutor - Cost",
  "description": "Model spend by day, model, feature, user and chat session (cost_details reported by backend/bedrock_llm.py).",
  "format": "langfuse-metrics-v2",
  "scope": "environment = production (set from ENVIRONMENT by backend/langfuse_setup.py)",
  "how_to_build": "Built in Langfuse by `python scripts/ci/sync_langfuse_dashboards.py` (edit this file, not the Langfuse UI: the sync deletes and recreates its dashboards). Each widget's `query` is the exact GET /api/public/v2/metrics query it charts; check them all against live data with `python scripts/langfuse/check_dashboards.py`.",
  "widgets": [
    {
      "title": "Total spend (USD)",
      "chartType": "NUMBER",
      "description": "",
      "query": {
        "view": "observations",
        "metrics": [
          {
            "measure": "totalCost",
            "aggregation": "sum"
          }
        ],
        "dimensions": [],
        "filters": [
          {
            "column": "environment",
            "operator": "=",
            "value": "production",
            "type": "string"
          },
          {
            "column": "name",
            "operator": "=",
            "value": "bedrock-generation",
            "type": "string"
          }
        ]
      },
      "layout": {
        "x": 0,
        "y": 0,
        "width": 3,
        "height": 4
      }
    },
    {
      "title": "Input vs output cost (USD)",
      "chartType": "HORIZONTAL_BAR",
      "description": "Prompt and completion cost.",
      "query": {
        "view": "observations",
        "metrics": [
          {
            "measure": "inputCost",
            "aggregation": "sum"
          },
          {
            "measure": "outputCost",
            "aggregation": "sum"
          }
        ],
        "dimensions": [],
        "filters": [
          {
            "column": "environment",
            "operator": "=",
            "value": "production",
            "type": "string"
          },
          {
            "column": "name",
            "operator": "=",
            "value": "bedrock-generation",
            "type": "string"
          }
        ]
      },
      "layout": {
        "x": 3,
        "y": 0,
        "width": 6,
        "height": 6
      }
    },
    {
      "title": "Spend over time (USD)",
      "chartType": "BAR_TIME_SERIES",
      "description": "",
      "query": {
        "view": "observations",
        "metrics": [
          {
            "measure": "totalCost",
            "aggregation": "sum"
          }
        ],
        "dimensions": [],
        "filters": [
          {
            "column": "environment",
            "operator": "=",
            "value": "production",
            "type": "string"
          },
          {
            "column": "name",
            "operator": "=",
            "value": "bedrock-generation",
            "type": "string"
          }
        ],
        "timeDimension": {
          "granularity": "auto"
        }
      },
      "layout": {
        "x": 0,
        "y": 6,
        "width": 6,
        "height": 6
      }
    },
    {
      "title": "Spend by model (USD)",
      "chartType": "HORIZONTAL_BAR",
      "description": "",
      "query": {
        "view": "observations",
        "metrics": [
          {
            "measure": "totalCost",
            "aggregation": "sum"
          },
          {
            "measure": "count",
            "aggregation": "count"
          }
        ],
        "dimensions": [
          {
            "field": "providedModelName"
          }
        ],
        "filters": [
          {
            "column": "environment",
            "operator": "=",
            "value": "production",
            "type": "string"
          },
          {
            "column": "name",
            "operator": "=",
            "value": "bedrock-generation",
            "type": "string"
          }
        ],
        "orderBy": [
          {
            "field": "sum_totalCost",
            "direction": "desc"
          }
        ]
      },
      "layout": {
        "x": 6,
        "y": 6,
        "width": 6,
        "height": 6
      }
    },
    {
      "title": "Spend by feature (USD)",
      "chartType": "HORIZONTAL_BAR",
      "description": "chat, quiz, code, research, rag.",
      "query": {
        "view": "observations",
        "metrics": [
          {
            "measure": "totalCost",
            "aggregation": "sum"
          }
        ],
        "dimensions": [
          {
            "field": "traceName"
          }
        ],
        "filters": [
          {
            "column": "environment",
            "operator": "=",
            "value": "production",
            "type": "string"
          },
          {
            "column": "name",
            "operator": "=",
            "value": "bedrock-generation",
            "type": "string"
          }
        ],
        "orderBy": [
          {
            "field": "sum_totalCost",
            "direction": "desc"
          }
        ]
      },
      "layout": {
        "x": 0,
        "y": 12,
        "width": 6,
        "height": 6
      }
    },
    {
      "title": "Top 10 users by spend",
      "chartType": "PIVOT_TABLE",
      "description": "Pseudonymous user ids; map one back with backend.log_redaction.user_ref(username).",
      "query": {
        "view": "observations",
        "metrics": [
          {
            "measure": "totalCost",
            "aggregation": "sum"
          },
          {
            "measure": "totalTokens",
            "aggregation": "sum"
          },
          {
            "measure": "count",
            "aggregation": "count"
          }
        ],
        "dimensions": [
          {
            "field": "userId"
          }
        ],
        "filters": [
          {
            "column": "environment",
            "operator": "=",
            "value": "production",
            "type": "string"
          },
          {
            "column": "name",
            "operator": "=",
            "value": "bedrock-generation",
            "type": "string"
          }
        ],
        "orderBy": [
          {
            "field": "sum_totalCost",
            "direction": "desc"
          }
        ],
        "config": {
          "row_limit": 10
        }
      },
      "chartConfig": {
        "row_limit": 10
      },
      "layout": {
        "x": 0,
        "y": 18,
        "width": 12,
        "height": 7
      }
    },
    {
      "title": "Top 10 chat sessions by spend",
      "chartType": "PIVOT_TABLE",
      "description": "",
      "query": {
        "view": "observations",
        "metrics": [
          {
            "measure": "totalCost",
            "aggregation": "sum"
          },
          {
            "measure": "count",
            "aggregation": "count"
          }
        ],
        "dimensions": [
          {
            "field": "sessionId"
          }
        ],
        "filters": [
          {
            "column": "environment",
            "operator": "=",
            "value": "production",
            "type": "string"
          },
          {
            "column": "name",
            "operator": "=",
            "value": "bedrock-generation",
            "type": "string"
          }
        ],
        "orderBy": [
          {
            "field": "sum_totalCost",
            "direction": "desc"
          }
        ],
        "config": {
          "row_limit": 10
        }
      },
      "chartConfig": {
        "row_limit": 10
      },
      "layout": {
        "x": 0,
        "y": 25,
        "width": 12,
        "height": 7
      }
    }
  ]
}
