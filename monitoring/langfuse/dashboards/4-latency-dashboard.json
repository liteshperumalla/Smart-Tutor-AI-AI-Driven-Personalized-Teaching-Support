{
  "id": "langfuse-latency-dashboard",
  "name": "Smart AI Tutor - Latency",
  "description": "Model response latency, time to first token and retrieval step timings (ms).",
  "format": "langfuse-metrics-v2",
  "scope": "environment = production (set from ENVIRONMENT by backend/langfuse_setup.py)",
  "how_to_build": "Built in Langfuse by `python scripts/ci/sync_langfuse_dashboards.py` (edit this file, not the Langfuse UI: the sync deletes and recreates its dashboards). Each widget's `query` is the exact GET /api/public/v2/metrics query it charts; check them all against live data with `python scripts/langfuse/check_dashboards.py`.",
  "widgets": [
    {
      "title": "Generation latency p50 / p90 / p95 / p99 (ms)",
      "chartType": "HORIZONTAL_BAR",
      "description": "",
      "query": {
        "view": "observations",
        "metrics": [
          {
            "measure": "latency",
            "aggregation": "p50"
          },
          {
            "measure": "latency",
            "aggregation": "p90"
          },
          {
            "measure": "latency",
            "aggregation": "p95"
          },
          {
            "measure": "latency",
            "aggregation": "p99"
          }
        ],
        "dimensions": [],
        "filters": [
          {
            "column": "environment",
            "operator": "=",
            "value": "production",
            "type": "string"
          },
          {
            "column": "name",
            "operator": "=",
            "value": "bedrock-generation",
            "type": "string"
          }
        ]
      },
      "layout": {
        "x": 0,
        "y": 0,
        "width": 6,
        "height": 6
      }
    },
    {
      "title": "Generation latency percentiles over time (ms)",
      "chartType": "LINE_TIME_SERIES",
      "description": "",
      "query": {
        "view": "observations",
        "metrics": [
          {
            "measure": "latency",
            "aggregation": "p50"
          },
          {
            "measure": "latency",
            "aggregation": "p90"
          },
          {
            "measure": "latency",
            "aggregation": "p99"
          }
        ],
        "dimensions": [],
        "filters": [
          {
            "column": "environment",
            "operator": "=",
            "value": "production",
            "type": "string"
          },
          {
            "column": "name",
            "operator": "=",
            "value": "bedrock-generation",
            "type": "string"
          }
        ],
        "timeDimension": {
          "granularity": "auto"
        }
      },
      "layout": {
        "x": 6,
        "y": 0,
        "width": 6,
        "height": 6
      }
    },
    {
      "title": "Time to first token by model (ms)",
      "chartType": "HORIZONTAL_BAR",
      "description": "Set on the first streamed token (completion_start_time).",
      "query": {
        "view": "observations",
        "metrics": [
          {
            "measure": "timeToFirstToken",
            "aggregation": "p50"
          },
          {
            "measure": "timeToFirstToken",
            "aggregation": "p95"
          }
        ],
        "dimensions": [
          {
            "field": "providedModelName"
          }
        ],
        "filters": [
          {
            "column": "environment",
            "operator": "=",
            "value": "production",
            "type": "string"
          },
          {
            "column": "name",
            "operator": "=",
            "value": "bedrock-generation",
            "type": "string"
          }
        ]
      },
      "layout": {
        "x": 0,
        "y": 6,
        "width": 6,
        "height": 6
      }
    },
    {
      "title": "Output tokens per second by model",
      "chartType": "HORIZONTAL_BAR",
      "description": "Streaming throughput.",
      "query": {
        "view": "observations",
        "metrics": [
          {
            "measure": "outputTokensPerSecond",
            "aggregation": "avg"
          }
        ],
        "dimensions": [
          {
            "field": "providedModelName"
          }
        ],
        "filters": [
          {
            "column": "environment",
            "operator": "=",
            "value": "production",
            "type": "string"
          },
          {
            "column": "name",
            "operator": "=",
            "value": "bedrock-generation",
            "type": "string"
          }
        ]
      },
      "layout": {
        "x": 6,
        "y": 6,
        "width": 6,
        "height": 6
      }
    },
    {
      "title": "Latency distribution (ms)",
      "chartType": "HISTOGRAM",
      "description": "",
      "query": {
        "view": "observations",
        "metrics": [
          {
            "measure": "latency",
            "aggregation": "histogram"
          }
        ],
        "dimensions": [],
        "filters": [
          {
            "column": "environment",
            "operator": "=",
            "value": "production",
            "type": "string"
          },
          {
            "column": "name",
            "operator": "=",
            "value": "bedrock-generation",
            "type": "string"
          }
        ]
      },
      "chartConfig": {
        "bins": 20
      },
      "layout": {
        "x": 0,
        "y": 12,
        "width": 6,
        "height": 6
      }
    },
    {
      "title": "Retrieval and pipeline steps p95 (ms)",
      "chartType": "HORIZONTAL_BAR",
      "description": "LlamaIndex retrieve/query spans and agent steps.",
      "query": {
        "view": "observations",
        "metrics": [
          {
            "measure": "latency",
            "aggregation": "p95"
          },
          {
            "measure": "count",
            "aggregation": "count"
          }
        ],
        "dimensions": [
          {
            "field": "name"
          }
        ],
        "filters": [
          {
            "column": "environment",
            "operator": "=",
            "value": "production",
            "type": "string"
          },
          {
            "column": "type",
            "operator": "=",
            "value": "SPAN",
            "type": "string"
          }
        ],
        "orderBy": [
          {
            "field": "p95_latency",
            "direction": "desc"
          }
        ],
        "config": {
          "row_limit": 15
        }
      },
      "chartConfig": {
        "row_limit": 15
      },
      "layout": {
        "x": 6,
        "y": 12,
        "width": 6,
        "height": 6
      }
    }
  ]
}
