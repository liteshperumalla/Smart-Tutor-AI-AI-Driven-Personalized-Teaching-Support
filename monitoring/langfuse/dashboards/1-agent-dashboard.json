{
  "id": "langfuse-agent-dashboard",
  "name": "Smart AI Tutor - Agents",
  "description": "Multi-agent pipeline (backend/agents): run volume, users, latency per pipeline step and failures. Agent runs are 'agent-pipeline' traces when the agent-system-enabled flag is on.",
  "format": "langfuse-metrics-v2",
  "scope": "environment = production (set from ENVIRONMENT by backend/langfuse_setup.py)",
  "how_to_build": "Built in Langfuse by `python scripts/ci/sync_langfuse_dashboards.py` (edit this file, not the Langfuse UI: the sync deletes and recreates its dashboards). Each widget's `query` is the exact GET /api/public/v2/metrics query it charts; check them all against live data with `python scripts/langfuse/check_dashboards.py`.",
  "widgets": [
    {
      "title": "Agent runs",
      "chartType": "NUMBER",
      "description": "Agent pipeline runs in the period.",
      "query": {
        "view": "observations",
        "metrics": [
          {
            "measure": "count",
            "aggregation": "count"
          }
        ],
        "dimensions": [],
        "filters": [
          {
            "column": "environment",
            "operator": "=",
            "value": "production",
            "type": "string"
          },
          {
            "column": "name",
            "operator": "=",
            "value": "agent-pipeline",
            "type": "string"
          }
        ]
      },
      "layout": {
        "x": 0,
        "y": 0,
        "width": 3,
        "height": 4
      }
    },
    {
      "title": "Agent users",
      "chartType": "NUMBER",
      "description": "Distinct users (pseudonymous u_\u2026 ids) who ran the agent pipeline.",
      "query": {
        "view": "observations",
        "metrics": [
          {
            "measure": "uniqueUserIds",
            "aggregation": "uniq"
          }
        ],
        "dimensions": [],
        "filters": [
          {
            "column": "environment",
            "operator": "=",
            "value": "production",
            "type": "string"
          },
          {
            "column": "name",
            "operator": "=",
            "value": "agent-pipeline",
            "type": "string"
          }
        ]
      },
      "layout": {
        "x": 3,
        "y": 0,
        "width": 3,
        "height": 4
      }
    },
    {
      "title": "Agent runs over time",
      "chartType": "BAR_TIME_SERIES",
      "description": "Daily agent pipeline runs.",
      "query": {
        "view": "observations",
        "metrics": [
          {
            "measure": "count",
            "aggregation": "count"
          }
        ],
        "dimensions": [],
        "filters": [
          {
            "column": "environment",
            "operator": "=",
            "value": "production",
            "type": "string"
          },
          {
            "column": "name",
            "operator": "=",
            "value": "agent-pipeline",
            "type": "string"
          }
        ],
        "timeDimension": {
          "granularity": "auto"
        }
      },
      "layout": {
        "x": 6,
        "y": 0,
        "width": 6,
        "height": 6
      }
    },
    {
      "title": "Agent run latency p50 / p95 (ms)",
      "chartType": "LINE_TIME_SERIES",
      "description": "End-to-end agent pipeline latency.",
      "query": {
        "view": "observations",
        "metrics": [
          {
            "measure": "latency",
            "aggregation": "p50"
          },
          {
            "measure": "latency",
            "aggregation": "p95"
          }
        ],
        "dimensions": [],
        "filters": [
          {
            "column": "environment",
            "operator": "=",
            "value": "production",
            "type": "string"
          },
          {
            "column": "name",
            "operator": "=",
            "value": "agent-pipeline",
            "type": "string"
          }
        ],
        "timeDimension": {
          "granularity": "auto"
        }
      },
      "layout": {
        "x": 0,
        "y": 6,
        "width": 6,
        "height": 6
      }
    },
    {
      "title": "Pipeline step latency p95 (ms)",
      "chartType": "HORIZONTAL_BAR",
      "description": "p95 per step: load-student-profile, agent-rag-retrieval, log-interaction.",
      "query": {
        "view": "observations",
        "metrics": [
          {
            "measure": "latency",
            "aggregation": "p95"
          },
          {
            "measure": "count",
            "aggregation": "count"
          }
        ],
        "dimensions": [
          {
            "field": "name"
          }
        ],
        "filters": [
          {
            "column": "environment",
            "operator": "=",
            "value": "production",
            "type": "string"
          },
          {
            "column": "traceName",
            "operator": "=",
            "value": "agent-pipeline",
            "type": "string"
          },
          {
            "column": "type",
            "operator": "=",
            "value": "SPAN",
            "type": "string"
          }
        ]
      },
      "layout": {
        "x": 6,
        "y": 6,
        "width": 6,
        "height": 6
      }
    },
    {
      "title": "Failed agent runs over time",
      "chartType": "BAR_TIME_SERIES",
      "description": "Agent runs flagged ERROR (LLM stream failed).",
      "query": {
        "view": "observations",
        "metrics": [
          {
            "measure": "count",
            "aggregation": "count"
          }
        ],
        "dimensions": [],
        "filters": [
          {
            "column": "environment",
            "operator": "=",
            "value": "production",
            "type": "string"
          },
          {
            "column": "name",
            "operator": "=",
            "value": "agent-pipeline",
            "type": "string"
          },
          {
            "column": "level",
            "operator": "=",
            "value": "ERROR",
            "type": "string"
          }
        ],
        "timeDimension": {
          "granularity": "auto"
        }
      },
      "layout": {
        "x": 0,
        "y": 12,
        "width": 6,
        "height": 6
      }
    }
  ]
}
