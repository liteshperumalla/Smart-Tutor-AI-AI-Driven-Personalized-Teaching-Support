{
  "id": "langfuse-usage-management",
  "name": "Smart AI Tutor - Usage",
  "description": "Token volume by day, feature and user, plus user satisfaction from chat thumbs up/down (Langfuse score user_feedback: 1 = up, 0 = down). Rate limiting (429s) and cache hit rate live in Grafana, not Langfuse.",
  "format": "langfuse-metrics-v2",
  "scope": "environment = production (set from ENVIRONMENT by backend/langfuse_setup.py)",
  "how_to_build": "Built in Langfuse by `python scripts/ci/sync_langfuse_dashboards.py` (edit this file, not the Langfuse UI: the sync deletes and recreates its dashboards). Each widget's `query` is the exact GET /api/public/v2/metrics query it charts; check them all against live data with `python scripts/langfuse/check_dashboards.py`.",
  "widgets": [
    {
      "title": "Total tokens",
      "chartType": "NUMBER",
      "description": "",
      "query": {
        "view": "observations",
        "metrics": [
          {
            "measure": "totalTokens",
            "aggregation": "sum"
          }
        ],
        "dimensions": [],
        "filters": [
          {
            "column": "environment",
            "operator": "=",
            "value": "production",
            "type": "string"
          },
          {
            "column": "name",
            "operator": "=",
            "value": "bedrock-generation",
            "type": "string"
          }
        ]
      },
      "layout": {
        "x": 0,
        "y": 0,
        "width": 3,
        "height": 4
      }
    },
    {
      "title": "Input vs output tokens per day",
      "chartType": "BAR_TIME_SERIES",
      "description": "",
      "query": {
        "view": "observations",
        "metrics": [
          {
            "measure": "inputTokens",
            "aggregation": "sum"
          },
          {
            "measure": "outputTokens",
            "aggregation": "sum"
          }
        ],
        "dimensions": [],
        "filters": [
          {
            "column": "environment",
            "operator": "=",
            "value": "production",
            "type": "string"
          },
          {
            "column": "name",
            "operator": "=",
            "value": "bedrock-generation",
            "type": "string"
          }
        ],
        "timeDimension": {
          "granularity": "day"
        }
      },
      "layout": {
        "x": 3,
        "y": 0,
        "width": 6,
        "height": 6
      }
    },
    {
      "title": "Tokens by feature",
      "chartType": "HORIZONTAL_BAR",
      "description": "",
      "query": {
        "view": "observations",
        "metrics": [
          {
            "measure": "totalTokens",
            "aggregation": "sum"
          }
        ],
        "dimensions": [
          {
            "field": "traceName"
          }
        ],
        "filters": [
          {
            "column": "environment",
            "operator": "=",
            "value": "production",
            "type": "string"
          },
          {
            "column": "name",
            "operator": "=",
            "value": "bedrock-generation",
            "type": "string"
          }
        ],
        "orderBy": [
          {
            "field": "sum_totalTokens",
            "direction": "desc"
          }
        ]
      },
      "layout": {
        "x": 0,
        "y": 6,
        "width": 6,
        "height": 6
      }
    },
    {
      "title": "Top 10 users by tokens",
      "chartType": "PIVOT_TABLE",
      "description": "Pseudonymous user ids.",
      "query": {
        "view": "observations",
        "metrics": [
          {
            "measure": "totalTokens",
            "aggregation": "sum"
          },
          {
            "measure": "inputTokens",
            "aggregation": "sum"
          },
          {
            "measure": "outputTokens",
            "aggregation": "sum"
          },
          {
            "measure": "count",
            "aggregation": "count"
          }
        ],
        "dimensions": [
          {
            "field": "userId"
          }
        ],
        "filters": [
          {
            "column": "environment",
            "operator": "=",
            "value": "production",
            "type": "string"
          },
          {
            "column": "name",
            "operator": "=",
            "value": "bedrock-generation",
            "type": "string"
          }
        ],
        "orderBy": [
          {
            "field": "sum_totalTokens",
            "direction": "desc"
          }
        ],
        "config": {
          "row_limit": 10
        }
      },
      "chartConfig": {
        "row_limit": 10
      },
      "layout": {
        "x": 0,
        "y": 12,
        "width": 12,
        "height": 7
      }
    },
    {
      "title": "User satisfaction (share of thumbs up)",
      "chartType": "NUMBER",
      "description": "Average of user_feedback scores.",
      "query": {
        "view": "scores-numeric",
        "metrics": [
          {
            "measure": "value",
            "aggregation": "avg"
          }
        ],
        "dimensions": [],
        "filters": [
          {
            "column": "environment",
            "operator": "=",
            "value": "production",
            "type": "string"
          },
          {
            "column": "name",
            "operator": "=",
            "value": "user_feedback",
            "type": "string"
          }
        ]
      },
      "layout": {
        "x": 0,
        "y": 19,
        "width": 3,
        "height": 4
      }
    },
    {
      "title": "User satisfaction per day",
      "chartType": "LINE_TIME_SERIES",
      "description": "",
      "query": {
        "view": "scores-numeric",
        "metrics": [
          {
            "measure": "value",
            "aggregation": "avg"
          },
          {
            "measure": "count",
            "aggregation": "count"
          }
        ],
        "dimensions": [],
        "filters": [
          {
            "column": "environment",
            "operator": "=",
            "value": "production",
            "type": "string"
          },
          {
            "column": "name",
            "operator": "=",
            "value": "user_feedback",
            "type": "string"
          }
        ],
        "timeDimension": {
          "granularity": "day"
        }
      },
      "layout": {
        "x": 3,
        "y": 19,
        "width": 6,
        "height": 6
      }
    }
  ]
}
