{
  "id": "langfuse-home-dashboard",
  "name": "Smart AI Tutor - Home",
  "description": "Overall LLM usage: traces, active users, chat sessions, spend, errors, feature and model mix.",
  "format": "langfuse-metrics-v2",
  "scope": "environment = production (set from ENVIRONMENT by backend/langfuse_setup.py)",
  "how_to_build": "Built in Langfuse by `python scripts/ci/sync_langfuse_dashboards.py` (edit this file, not the Langfuse UI: the sync deletes and recreates its dashboards). Each widget's `query` is the exact GET /api/public/v2/metrics query it charts; check them all against live data with `python scripts/langfuse/check_dashboards.py`.",
  "widgets": [
    {
      "title": "Traces",
      "chartType": "NUMBER",
      "description": "Root traces (one per LLM request or agent run).",
      "query": {
        "view": "observations",
        "metrics": [
          {
            "measure": "count",
            "aggregation": "count"
          }
        ],
        "dimensions": [],
        "filters": [
          {
            "column": "environment",
            "operator": "=",
            "value": "production",
            "type": "string"
          },
          {
            "column": "isRootObservation",
            "operator": "=",
            "value": true,
            "type": "boolean"
          }
        ]
      },
      "layout": {
        "x": 0,
        "y": 0,
        "width": 3,
        "height": 4
      }
    },
    {
      "title": "Active users",
      "chartType": "NUMBER",
      "description": "Distinct pseudonymous users.",
      "query": {
        "view": "observations",
        "metrics": [
          {
            "measure": "uniqueUserIds",
            "aggregation": "uniq"
          }
        ],
        "dimensions": [],
        "filters": [
          {
            "column": "environment",
            "operator": "=",
            "value": "production",
            "type": "string"
          },
          {
            "column": "isRootObservation",
            "operator": "=",
            "value": true,
            "type": "boolean"
          }
        ]
      },
      "layout": {
        "x": 3,
        "y": 0,
        "width": 3,
        "height": 4
      }
    },
    {
      "title": "Chat sessions",
      "chartType": "NUMBER",
      "description": "Distinct chat sessions with LLM traffic.",
      "query": {
        "view": "observations",
        "metrics": [
          {
            "measure": "uniqueSessionIds",
            "aggregation": "uniq"
          }
        ],
        "dimensions": [],
        "filters": [
          {
            "column": "environment",
            "operator": "=",
            "value": "production",
            "type": "string"
          },
          {
            "column": "isRootObservation",
            "operator": "=",
            "value": true,
            "type": "boolean"
          }
        ]
      },
      "layout": {
        "x": 6,
        "y": 0,
        "width": 3,
        "height": 4
      }
    },
    {
      "title": "LLM spend (USD)",
      "chartType": "NUMBER",
      "description": "Total model cost from Bedrock usage.",
      "query": {
        "view": "observations",
        "metrics": [
          {
            "measure": "totalCost",
            "aggregation": "sum"
          }
        ],
        "dimensions": [],
        "filters": [
          {
            "column": "environment",
            "operator": "=",
            "value": "production",
            "type": "string"
          },
          {
            "column": "name",
            "operator": "=",
            "value": "bedrock-generation",
            "type": "string"
          }
        ]
      },
      "layout": {
        "x": 9,
        "y": 0,
        "width": 3,
        "height": 4
      }
    },
    {
      "title": "Failed generations",
      "chartType": "NUMBER",
      "description": "Generations that ended with level ERROR.",
      "query": {
        "view": "observations",
        "metrics": [
          {
            "measure": "count",
            "aggregation": "count"
          }
        ],
        "dimensions": [],
        "filters": [
          {
            "column": "environment",
            "operator": "=",
            "value": "production",
            "type": "string"
          },
          {
            "column": "name",
            "operator": "=",
            "value": "bedrock-generation",
            "type": "string"
          },
          {
            "column": "level",
            "operator": "=",
            "value": "ERROR",
            "type": "string"
          }
        ]
      },
      "layout": {
        "x": 0,
        "y": 4,
        "width": 3,
        "height": 4
      }
    },
    {
      "title": "Traces over time by feature",
      "chartType": "BAR_TIME_SERIES",
      "description": "Feature = trace name: chat, quiz, code, research, rag, agent-pipeline.",
      "query": {
        "view": "observations",
        "metrics": [
          {
            "measure": "count",
            "aggregation": "count"
          }
        ],
        "dimensions": [
          {
            "field": "traceName"
          }
        ],
        "filters": [
          {
            "column": "environment",
            "operator": "=",
            "value": "production",
            "type": "string"
          },
          {
            "column": "isRootObservation",
            "operator": "=",
            "value": true,
            "type": "boolean"
          }
        ],
        "timeDimension": {
          "granularity": "auto"
        }
      },
      "layout": {
        "x": 3,
        "y": 4,
        "width": 6,
        "height": 6
      }
    },
    {
      "title": "Generations by model",
      "chartType": "PIE",
      "description": "Model that served each generation.",
      "query": {
        "view": "observations",
        "metrics": [
          {
            "measure": "count",
            "aggregation": "count"
          }
        ],
        "dimensions": [
          {
            "field": "providedModelName"
          }
        ],
        "filters": [
          {
            "column": "environment",
            "operator": "=",
            "value": "production",
            "type": "string"
          },
          {
            "column": "name",
            "operator": "=",
            "value": "bedrock-generation",
            "type": "string"
          }
        ]
      },
      "layout": {
        "x": 0,
        "y": 10,
        "width": 6,
        "height": 6
      }
    },
    {
      "title": "Generation latency p95 (ms)",
      "chartType": "LINE_TIME_SERIES",
      "description": "Daily p95 of a full model response.",
      "query": {
        "view": "observations",
        "metrics": [
          {
            "measure": "latency",
            "aggregation": "p95"
          }
        ],
        "dimensions": [],
        "filters": [
          {
            "column": "environment",
            "operator": "=",
            "value": "production",
            "type": "string"
          },
          {
            "column": "name",
            "operator": "=",
            "value": "bedrock-generation",
            "type": "string"
          }
        ],
        "timeDimension": {
          "granularity": "auto"
        }
      },
      "layout": {
        "x": 6,
        "y": 10,
        "width": 6,
        "height": 6
      }
    }
  ]
}
