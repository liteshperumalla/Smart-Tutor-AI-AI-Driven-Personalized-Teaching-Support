{
  "dashboard": {
    "title": "FinOps Cost Dashboard - Smart AI Tutor",
    "tags": ["finops", "cost", "optimization"],
    "timezone": "browser",
    "schemaVersion": 36,
    "version": 1,
    "refresh": "5m",
    "panels": [
      {
        "id": 1,
        "title": "Total Monthly Cost",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
        "targets": [{
          "expr": "sum(kubecost_cluster_management_cost + kubecost_cluster_compute_cost + kubecost_cluster_storage_cost + kubecost_cluster_network_cost)",
          "refId": "A"
        }],
        "fieldConfig": {
          "defaults": {
            "unit": "currencyUSD",
            "decimals": 2,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "green", "value": 0},
                {"color": "yellow", "value": 8000},
                {"color": "red", "value": 10000}
              ]
            }
          }
        },
        "options": {
          "colorMode": "background",
          "graphMode": "area"
        }
      },
      {
        "id": 2,
        "title": "Cost Trend (30 days)",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 6, "y": 0},
        "targets": [{
          "expr": "sum(rate(kubecost_cluster_management_cost[1d]) + rate(kubecost_cluster_compute_cost[1d]) + rate(kubecost_cluster_storage_cost[1d]) + rate(kubecost_cluster_network_cost[1d]))",
          "refId": "A",
          "legendFormat": "Total Daily Cost"
        }],
        "fieldConfig": {
          "defaults": {
            "unit": "currencyUSD",
            "custom": {
              "drawStyle": "line",
              "lineWidth": 2,
              "fillOpacity": 10
            }
          }
        }
      },
      {
        "id": 3,
        "title": "Budget vs Actual",
        "type": "gauge",
        "gridPos": {"h": 4, "w": 6, "x": 0, "y": 4},
        "targets": [{
          "expr": "(sum(kubecost_cluster_management_cost + kubecost_cluster_compute_cost + kubecost_cluster_storage_cost + kubecost_cluster_network_cost) / 10000)",
          "refId": "A"
        }],
        "fieldConfig": {
          "defaults": {
            "unit": "percentunit",
            "min": 0,
            "max": 1,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "green", "value": 0},
                {"color": "yellow", "value": 0.5},
                {"color": "orange", "value": 0.8},
                {"color": "red", "value": 0.95}
              ]
            }
          }
        }
      },
      {
        "id": 4,
        "title": "Cost by Resource Type",
        "type": "piechart",
        "gridPos": {"h": 8, "w": 6, "x": 18, "y": 0},
        "targets": [
          {
            "expr": "sum(kubecost_cluster_compute_cost)",
            "refId": "A",
            "legendFormat": "Compute"
          },
          {
            "expr": "sum(kubecost_cluster_storage_cost)",
            "refId": "B",
            "legendFormat": "Storage"
          },
          {
            "expr": "sum(kubecost_cluster_network_cost)",
            "refId": "C",
            "legendFormat": "Network"
          },
          {
            "expr": "sum(kubecost_cluster_management_cost)",
            "refId": "D",
            "legendFormat": "Management"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "currencyUSD"
          }
        },
        "options": {
          "legend": {
            "displayMode": "table",
            "placement": "right",
            "values": ["value", "percent"]
          }
        }
      },
      {
        "id": 5,
        "title": "Cost by Namespace",
        "type": "table",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
        "targets": [{
          "expr": "sum by (namespace) (kubecost_namespace_cost)",
          "refId": "A",
          "format": "table",
          "instant": true
        }],
        "transformations": [
          {
            "id": "organize",
            "options": {
              "renameByName": {
                "Value": "Monthly Cost"
              }
            }
          }
        ],
        "fieldConfig": {
          "overrides": [
            {
              "matcher": {"id": "byName", "options": "Monthly Cost"},
              "properties": [
                {"id": "unit", "value": "currencyUSD"},
                {"id": "custom.displayMode", "value": "color-background"}
              ]
            }
          ]
        }
      },
      {
        "id": 6,
        "title": "Cost by Team/App",
        "type": "table",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
        "targets": [{
          "expr": "sum by (app, team) (kubecost_pod_cost)",
          "refId": "A",
          "format": "table",
          "instant": true
        }],
        "fieldConfig": {
          "overrides": [
            {
              "matcher": {"id": "byName", "options": "Value"},
              "properties": [
                {"id": "unit", "value": "currencyUSD"},
                {"id": "decimals", "value": 2}
              ]
            }
          ]
        }
      },
      {
        "id": 7,
        "title": "Savings Opportunities",
        "type": "table",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
        "targets": [{
          "expr": "topk(10, kubecost_savings_rightsizing)",
          "refId": "A",
          "format": "table",
          "instant": true
        }]
      },
      {
        "id": 8,
        "title": "Idle Resources Cost",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 12, "y": 16},
        "targets": [{
          "expr": "sum(kubecost_idle_cost)",
          "refId": "A"
        }],
        "fieldConfig": {
          "defaults": {
            "unit": "currencyUSD",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "green", "value": 0},
                {"color": "yellow", "value": 500},
                {"color": "red", "value": 1000}
              ]
            }
          }
        },
        "options": {
          "colorMode": "background"
        }
      },
      {
        "id": 9,
        "title": "Efficiency Score",
        "type": "gauge",
        "gridPos": {"h": 4, "w": 6, "x": 18, "y": 16},
        "targets": [{
          "expr": "1 - (sum(kubecost_idle_cost) / sum(kubecost_cluster_cost))",
          "refId": "A"
        }],
        "fieldConfig": {
          "defaults": {
            "unit": "percentunit",
            "min": 0,
            "max": 1,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "red", "value": 0},
                {"color": "yellow", "value": 0.7},
                {"color": "green", "value": 0.85}
              ]
            }
          }
        }
      },
      {
        "id": 10,
        "title": "Cost Per Request",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 12, "y": 20},
        "targets": [{
          "expr": "sum(kubecost_cluster_cost) / sum(rate(http_requests_total[30d]))",
          "refId": "A"
        }],
        "fieldConfig": {
          "defaults": {
            "unit": "currencyUSD",
            "decimals": 6
          }
        }
      },
      {
        "id": 11,
        "title": "Cost Per User",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 18, "y": 20},
        "targets": [{
          "expr": "sum(kubecost_cluster_cost) / scalar(count(count by (user_id) (user_activity)))",
          "refId": "A"
        }],
        "fieldConfig": {
          "defaults": {
            "unit": "currencyUSD",
            "decimals": 2
          }
        }
      }
    ]
  }
}
